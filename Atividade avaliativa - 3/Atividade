import random
import sys

# Aumentar limite de recursao para o QuickSort com 1000 elementos
sys.setrecursionlimit(2000)

class Contador:
    def __init__(self):
        self.comparacoes = 0
        self.movimentacoes = 0

def bubble_sort(arr):
    c = Contador()
    v = arr.copy()
    n = len(v)
    for i in range(n):
        trocou = False
        for j in range(0, n - i - 1):
            c.comparacoes += 1
            if v[j] > v[j + 1]:
                v[j], v[j + 1] = v[j + 1], v[j]
                c.movimentacoes += 1
                trocou = True
        if not trocou:
            break
    return c.comparacoes, c.movimentacoes

def insertion_sort(arr):
    c = Contador()
    v = arr.copy()
    for i in range(1, len(v)):
        chave = v[i]
        j = i - 1
        while j >= 0:
            c.comparacoes += 1
            if v[j] > chave:
                v[j + 1] = v[j]
                c.movimentacoes += 1
                j -= 1
            else:
                break
        if j >= 0:
            c.comparacoes += 1
        v[j + 1] = chave
        c.movimentacoes += 1
    return c.comparacoes, c.movimentacoes

def selection_sort(arr):
    c = Contador()
    v = arr.copy()
    n = len(v)
    for i in range(n):
        min_idx = i
        for j in range(i + 1, n):
            c.comparacoes += 1
            if v[j] < v[min_idx]:
                min_idx = j
        if min_idx != i:
            v[i], v[min_idx] = v[min_idx], v[i]
            c.movimentacoes += 1
    return c.comparacoes, c.movimentacoes

def quick_sort(arr):
    c = Contador()
    v = arr.copy()

    def _partition(low, high):
        pivot = v[high]
        i = low - 1
        for j in range(low, high):
            c.comparacoes += 1
            if v[j] <= pivot:
                i += 1
                v[i], v[j] = v[j], v[i]
                c.movimentacoes += 1
        v[i + 1], v[high] = v[high], v[i + 1]
        c.movimentacoes += 1
        return i + 1

    def _quicksort(low, high):
        if low < high:
            pi = _partition(low, high)
            _quicksort(low, pi - 1)
            _quicksort(pi + 1, high)

    _quicksort(0, len(v) - 1)
    return c.comparacoes, c.movimentacoes

